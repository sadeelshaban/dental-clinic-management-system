# Copy to .env and adjust before: docker compose up -d
# cp .env.example .env

# MariaDB (docker service: mariadb)
MARIADB_ROOT_PASSWORD=change_me_root_password
MARIADB_PORT=3306

# API (docker service: api) — host port maps to container 8080
API_PORT=5062

# Frontend (docker service: web) — nginx SPA, proxies /api to the API container
WEB_PORT=5173

# JWT signing key — MUST be at least 32 characters
JWT_SECRET=change_me_to_a_secure_random_secret_key_32chars
